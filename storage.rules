rules_version = '2';

// Mismo modelo que firestore.rules: los custom claims { clienteId, rol } del
// token y, para lo delicado, el perfil y los documentos de Firestore.

service firebase.storage {
  match /b/{bucket}/o {

    function delCliente(c) {
      return request.auth != null && request.auth.token.clienteId == c;
    }

    function perfil(c) {
      return firestore.get(/databases/(default)/documents/clientes/$(c)/usuarios/$(request.auth.uid)).data;
    }

    function esAdmin(c) {
      return delCliente(c)
        && request.auth.token.rol == 'admin'
        && perfil(c).rol == 'admin'
        && perfil(c).activo == true;
    }

    // Fotos de los controles de agua: clientes/{c}/controlesAgua/{uid}/{controlId}.jpg
    match /clientes/{c}/controlesAgua/{uid}/{archivo} {
      allow read: if esAdmin(c) || (delCliente(c) && request.auth.uid == uid);

      // Solo el autor del control, despues de crear el documento en
      // Firestore (que fija esta ruta en fotoPath), una sola vez y como JPEG
      // de hasta 5 MB.
      allow create: if delCliente(c)
        && request.auth.uid == uid
        && resource == null
        && archivo.matches('^[A-Za-z0-9]{20}[.]jpg$')
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg'
        && firestore.get(/databases/(default)/documents/clientes/$(c)/controlesAgua/$(archivo.split('[.]')[0])).data.fotoPath
          == 'clientes/' + c + '/controlesAgua/' + uid + '/' + archivo;

      // Nada se borra: los controles se anulan, no se eliminan.
      allow update, delete: if false;
    }

    // Logo de la empresa: publico (se muestra en el login). Lo sube el admin
    // y despues lo activa con la Cloud Function actualizarEmpresa.
    match /clientes/{c}/branding/{archivo} {
      allow read: if true;
      allow create: if esAdmin(c)
        && resource == null
        && archivo.matches('^logo-[0-9]{10,16}[.](png|jpg|webp)$')
        && request.resource.size <= 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
