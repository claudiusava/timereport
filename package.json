{
  "name": "timereport",
  "version": "3.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "emulators": "cross-env FUNCTIONS_DISCOVERY_TIMEOUT=60 firebase emulators:start --project demo-timereport",
    "seed": "tsx functions/cli/demo.ts --emulador",
    "test:unit": "vitest run --dir tests/unit",
    "test:rules": "firebase emulators:exec --project demo-timereport --only auth,firestore,storage \"vitest run --dir tests/rules\"",
    "test:functions": "npm --prefix functions run build && cross-env FUNCTIONS_DISCOVERY_TIMEOUT=60 firebase emulators:exec --project demo-timereport --only auth,firestore,storage,functions \"vitest run --dir tests/functions\"",
    "test": "npm run test:unit && npm run test:rules && npm run test:functions"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.2",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.2",
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "@material-symbols/svg-400": "^0.48.0",
    "@material/material-color-utilities": "^0.4.0",
    "exceljs": "^4.4.0",
    "firebase": "^13.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^22.0.0",
    "cross-env": "^10.1.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.33.0",
    "jpeg-js": "^0.4.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.0.4"
  }
}
