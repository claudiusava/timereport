                cells: "sh",
                style: {
                  font: {
                    name: "Arial",
                    size: "12",
                    color: "FFFFFF",
                    b: true
                  },
                  fill: {
                    pattern: {
                      color: "6200ee",
                    }
                  },
                  border: {
                    top: "thin",
                    bottom: "thin",
                    left: "thin",
                    right: "thin"
                  },
                  alignment: {
                    vertical: "center",
                    horizontal: "center"
                  }
                },
              },
              {
                cells: "s",
                style: {
                  fill: {
                    pattern: {
                      color: "CACACA"
                    }
                  },
                  border: {
                    top: "thin",
                    bottom: "thin",
                    left: "thin",
                    right: "thin"
                  }
                }
              },
              {
                cells: "sB",
                style: {
                  alignment: {
                    vertical: "center",
                    horizontal: "center"
                  }
                }
              },
              {
                cells: "sD",
                style: {
                  alignment: {
                    vertical: "center",
                    horizontal: "center",
                  },
                  fill: {
                    width: "50"
                  }
                }
              },
              {
                cells: "sE",
                style: {
                  alignment: {
                    vertical: "center",
                    horizontal: "center"
                  }
                }
              }
            ]
          }
        ]
      },
