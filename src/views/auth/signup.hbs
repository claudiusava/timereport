      order: [[3, 'des']],
      buttons: {
        dom: {
          button: {
            className: 'btn'
          }
        },
        buttons: [
          {
            extend: "excel",
            text: 'Exportar a excel',
            className: 'btn btn-success',
            init: function (api, node, config) {
              initSelector(node).css('float', 'left');
            },
            margin: '100px',
            excelStyles: [
              {
                cells: "sh",
                style: {
                  font: {
                    name: "Arial",
                    size: "12",
