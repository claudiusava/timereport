<body>
  {{!-- Card principal --}}
  <div class="container p-4">
    <div class="row">
      <div class="col-md-4 mx-auto">
        <div class="card text-center">
          <div class="card-header">
            <strong>
              Añade un nuevo usuario.
            </strong>
          </div>
          <div class="card-body">
            <form id="myForm" action="/signup" method="POST">
              <div class="form-group">
                <input type="text" name="fullname" placeholder="nombre y apellido" class="form-control" autofocus
                  required />
              </div>
              <div class="form-group">
                <input type="text" name="username" placeholder="usuario" class="form-control" pattern="^\S+$"
                  required />
              </div>
              <div class="form-group">
                <input type="password" name="password" placeholder="contraseña" class="form-control" required />
              </div>
              <p style="font-size: 11px; text-align: left;">* Si no seleccionas ninguna de las siguientes opciones se
                aplicarán
                permisos mínimos (Partes de trabajo)</p>
              <div class="form-group" style="text-align: left;">
                <input class="form-check-input" name="role" type="radio" 
                id="permisoDeAdministracion" value="admin" onclick="$('#comunidadesSelect').hide()" required /> Permiso de administración (control total).
              </div>
              <div class="form-group" style="text-align: left;">
                <input type="radio" class="form-check-input" name="role" 
                id="socorrista" value="socorrista" onclick="$('#comunidadesSelect').show()" /> Socorrista.
              </div>
              <div class="form-group" id="comunidadesSelect" style="display: none;">
                <label for="comunidad">Asociar comunidad</label>
                <div class="form-group">
                  <input id="filter" type="text" placeholder="Buscar comunidades" class="filter">
                  <div class="scrollable-label" id="mdi" style="text-align: left; margin-left: 20px;">
                    {{#each comunidadesSelect}}
                      <span>
                        <input type="checkbox" class="form-check-input" name="comunidad" value="{{codigo}}"
                          data-comunidad="{{nombre}}">
                        {{nombre}}
                      </span>
                    {{/each}}
                  </div>
                </div>
              </div>
              <input type="hidden" name="comunidadesAsociadas" id="comunidadesAsociadasInput">
              <input type="hidden" name="comunidadesAsociadasAll" id="comunidadesAsociadasInputAll">
              <div class="form-group">
                <button class="btn btn-success">Guardar</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>


  {{!-- TABLA --}}
  <div class="container p-4">
    <div class="row">
      <div class=" mx-auto">
        <div class="card text-center">
          <div class="card-header">
            <div class="card-body">
              <h1>Usuarios registrados</h1>
              <div class="table-responsive">
                <table id="tabla" class="table table-bordered table-striped text-center mt-4">
                  <thead>
                    <tr class="text-white" style="background-color:#6200ee;">
                      <th scope="col">NOMBRE</th>
                      <th scope="col">USUARIO</th>
                      <th scope="col">SOCORRISTA</th>
                      <th scope="col">ADMINISTRADOR</th>
                      <th scope="col">ACCIONES</th>
                    </tr>
                  </thead>
                  <tbody>
                    {{#each usuarios}}
                    <tr>
                      <td>
                        <p class="mb-1">{{fullname}}</p>
                      </td>
                      <td>
                        <p class="mb-1">{{username}}</p>
                      </td>
                      <td>
                        <p class="mb-1" id="socorristaTable">{{socorrista}}</p>
                      </td>
                      <td>
                        <p class="mb-1" id="permisoDeAministracion">{{permisoDeAdministracion}}</p>
                      </td>
                      <td><a class="btn m-1 fa-solid fa-pen-to-square" style="font-size: large; color: blue;"
                          onclick="editar({{id}}, '{{fullname}}', '{{username}}', '{{socorrista}}', '{{permisoDeAdministracion}}')"></a>
                        <a class="btn m-1 fa-solid fa-trash-can" style="font-size: large; color: red;"
                          onclick="borrar({{id}})"></a>
                      </td>
                    </tr>
                    {{/each}}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script>

  var originalHtml = ""

  function fetchAsignedComunidades(id){
    fetch(`/coumunidadesById/${id}`).then((response) => response.json())
    .then((res) => {
          $('#hide').html(originalHtml);

          let comunidadesCheckCodigos = res.comunidades.map(function(comunidad) {
            return comunidad.codigo;
          });

          console.log(comunidadesCheckCodigos)

        $('.swal2-input[name="comunidad"]').each(function() {
          var codigo = $(this).val();          
          // Check if the current 'codigo' exists in fetched array
          if (comunidadesCheckCodigos.includes(codigo)) {
            $(this).prop('checked', true);
          }
        });
        setupFiltering('#filter2', '#mdi2 > span');
    })
  }

    function borrar(id) {
      Swal.fire({
        title: '¿Seguro que quieres eliminar este usuario?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Eliminar',
        confirmButtonColor: '#d63030',
        focusConfirm: 'true'
      }).then((result) => {
        if (result.isConfirmed) {
          window.location = '/auth/signup/delete/' + id;
        }
      })
    }

    function editar(id, fullname, username, socorrista, permisoDeAdministracion ) {
      let isAdmin = permisoDeAdministracion == 'Si'
      let checked1 = isAdmin ? 'checked' : '';
      let checked2 = socorrista == 'Si' ? 'checked' : '';
      if(!isAdmin) fetchAsignedComunidades(id)
      const formHTML = `
      <form id="editarUserForm"">
        <div class="form-group">
          <label for="nombreEdit">Nombre:</label>
          <input type="text" id="nombreEdit" class="swal2-input form-control" value="${fullname}" required>
        </div>
        <div class="form-group">
          <label for="usernameEdit">Username:</label>
          <input type="text" id="usernameEdit" class="swal2-input form-control" pattern="^\S+$"
            required  value="${username}" disabled/>
        </div>
        <div id="hide">
          <div class="form-group" style="text-align: left; margin-left: 20px;">
            <input class="swal2-input correct-height" name="role" type="radio" id="adminRadio" value="admin" ${checked1} onclick="$('#hide2').hide()" /> Administrador
          </div>
          <div class="form-group" style="text-align: left; margin-left: 20px;">
            <input type="radio" name="role" class="swal2-input correct-height" id="socorristaRadio" value="socorrista" onclick="$('#hide2').show()" ${checked2} /> Socorrista
          </div>
          <div class="form-group" id="hide2">
            <label for="usernameEdit">Comunidades:</label><br>
            <input id="filter2" type="text" placeholder="Buscar comunidades" class="filter" style="margin-bottom: 8px; height: 22px;">
            <div class="scrollable-label" id="mdi2" style="text-align: left; margin-left: 20px;">
              {{#each comunidadesSelect}}
                <span>
                  <input type="checkbox" class="swal2-input correct-height" name="comunidad" value="{{codigo}}"
                    data-comunidad="{{nombre}}">
                  {{nombre}}
                </span>
              {{/each}}
            </div>
          </div>
        </div>        
      </form>`;

      const swalWithForm = Swal.fire({
        title: 'Editar Usuario',
        html: formHTML,
        showCancelButton: true,
        confirmButtonText: 'Guardar Cambios',
        cancelButtonText: 'Cancelar',
        focusConfirm: false,
        showLoaderOnConfirm: true,
        preConfirm: () => {
          var comunidades = [];
          $('.swal2-input[name="comunidad"]:checked').each(function () {
            comunidades.push($(this).val());
          });
          console.log(comunidades)
          let checkAdmin = $('#adminRadio').is(':checked')
          let checkSoco = $('#socorristaRadio').is(':checked')
           return [ $('#nombreEdit').val(), $('#usernameEdit').val(), checkSoco, checkAdmin, comunidades ] }
      });

      if(isAdmin) $("#hide").hide()
      else{
        originalHtml = $('#hide').html();
        $('#hide').html('<div class="spinner-border" role="status"><span class="sr-only">Loading...</span></div>');
      }
      // Agregar un botón personalizado de "Guardar Cambios" al modal
      swalWithForm.then((result) => {
        const res = result.value;
        if (result.isConfirmed) {
          Swal.fire({
            title: '¿Seguro que quieres guardar los cambios?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Sí',
            cancelButtonText: 'No'
          }).then((result) => {
            if (result.isConfirmed) {
              // Enviar el formulario al servidor
              if(res[3]) window.location = `/userEdit?id=${id}&fullname=${res[0]}&username=${res[1]}&socorrista=false&admin=true`;
              else window.location = `/userEdit?id=${id}&fullname=${res[0]}&username=${res[1]}&socorrista=${res[2]}&admin=${res[3]}&${encodeArray('codes', res[4])}`;     
            }
          });
        }
      });
    }

    function encodeArray(key, array) {
      return array.map(value => `${encodeURIComponent(key)}=${encodeURIComponent(value)}`).join('&');
    }

    // Declaración de variables
    const permisoAdminCheckbox = document.getElementById('permisoDeAdministracion');
    var socorristaCheckbox = document.getElementById('socorrista');
    var comunidadesSelect = document.getElementById('comunidadesSelect');

    // Si permisoDeAdministracion devuelve un 1 de bbdd que el valor sea "si"
    if (permisoDeAdministracion == 1) {
      document.getElementById('permisoDeAdministracion').value = 'si';
    }

    document.querySelector("form").addEventListener("submit", function (event) {
      event.preventDefault(); // Evita que el formulario se envíe

      var comunidadesAsociadas = [];
      var comunidadesAsociadasAll = [];
      var checkboxesComunidades = document.getElementsByName("comunidad");

      for (var i = 0; i < checkboxesComunidades.length; i++) {
        if (checkboxesComunidades[i].checked) {
          comunidadesAsociadas.push(checkboxesComunidades[i].value);
        }
      }

      for (var i = 0; i < checkboxesComunidades.length; i++) {
        if (checkboxesComunidades[i]) {
          comunidadesAsociadasAll.push(checkboxesComunidades[i].value);
        }
      }
      
      document.getElementById('comunidadesAsociadasInput').value = comunidadesAsociadas.join(',');
      document.getElementById('comunidadesAsociadasInputAll').value = comunidadesAsociadasAll.join(',');

      // Enviar el formulario
      this.submit();
    });

    function setupFiltering(filterId, elementsSelector) {
      const filterEl = document.querySelector(filterId);
      const els = Array.from(document.querySelectorAll(elementsSelector));
      const labels = els.map(el => el.textContent);
      
      const handler = value => {
        const matching = labels.map((label, idx, arr) => label.toLowerCase().includes(value.toLowerCase()) ? idx : null).filter(el => el != null);

        els.forEach((el, idx) => {
          el.style.display = matching.includes(idx) ? 'block' : 'none';
        });
      };

      filterEl.addEventListener('keyup', () => handler(filterEl.value));
    }

    setupFiltering('#filter', '#mdi > span');

    var initSelector = jQuery.noConflict();
    initSelector('#tabla').DataTable({
      lengthMenu: [
        [10, 25, 50, 100, -1],
        ['10', '25', '50', '100', 'todos']
      ],
