    src="https://cdn.jsdelivr.net/npm/datatables-buttons-excel-styles@1.2.0/js/buttons.html5.styles.min.js"></script>
  <script
    src="https://cdn.jsdelivr.net/npm/datatables-buttons-excel-styles@1.2.0/js/buttons.html5.styles.templates.min.js"></script>

  <script>
    function confirmar(id) {
      Swal.fire({
        title: '¿Seguro que quieres eliminar este usuario?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Eliminar',
        confirmButtonColor: '#d63030',
        focusConfirm: 'true'
      }).then((result) => {
        if (result.isConfirmed) {
          window.location = '/auth/signup/delete/' + id;
        }
      })
    }

    if (permisoDeAdministracion == 1) {
      document.getElementById('permisoDeAdministracion').value = 'si';
    }

    var maquinistaCheckbox = document.getElementById('maquinista');
    var maquinistaSelect = document.getElementById('maquinistaSelect');

    maquinistaCheckbox.addEventListener('change', function () {
      if (maquinistaCheckbox.checked) {
        maquinistaSelect.style.display = 'block';
      } else {
        maquinistaSelect.style.display = 'none';
      }
    });

    var socorristaCheckbox = document.getElementById('socorrista');
    var comunidadesSelect = document.getElementById('comunidadesSelect');

    socorristaCheckbox.addEventListener('change', function () {
      if (socorristaCheckbox.checked) {
        comunidadesSelect.style.display = 'block';
      } else {
        comunidadesSelect.style.display = 'none';
      }
    });


    var initSelector = jQuery.noConflict();
    initSelector('#tabla').DataTable({
      lengthMenu: [
        [10, 25, 50, 100, -1],
        ['10', '25', '50', '100', 'todos']
