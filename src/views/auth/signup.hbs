<html>

<head>
  <link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css">
  <link rel="stylesheet" type="text/css"
    href="https://cdn.datatables.net/buttons/2.2.2/css/buttons.bootstrap5.min.css" />

</head>

<body>
  {{!-- Card principal --}}
  <div class="container p-4">
    <div class="row">
      <div class="col-md-4 mx-auto">
        <div class="card text-center">
          <div class="card-header">
            <strong>
              Añade un nuevo usuario.
            </strong>
          </div>
          <div class="card-body">
            <form action="/signup" method="POST">
              <div class="form-group">
                <input type="text" name="fullname" placeholder="nombre" class="form-control" autofocus required />
              </div>
              <div class="form-group">
                <input type="text" name="username" placeholder="usuario" class="form-control" required />
              </div>
              <div class="form-group">
                <input type="password" name="password" placeholder="contraseña" class="form-control" required />
              </div>
              <div class="form-group" style="text-align: left;">
                <input class="form-check-input" type="checkbox" name="permisoDeAdministracion"
                  id="permisoDeAdministracion" /> Permiso de administración
              </div>
              <div class="form-group" style="text-align: left;">
                <input type="checkbox" name="maquinista" id="maquinista" /> Responsable de furgoneta
              </div>
              <div class="form-group" id="maquinistaSelect" style="display: none;">
                <label for="maquinista">Asociar vehículos</label>
                <div class="form-group">
                  <div class="scrollable-label" style="text-align: left; margin-left: 20px;">
                    {{#each vehiculosSelect}}
                    <div class="checkbox">
                      <label>
                        <input type="checkbox" name="maquinista" value="{{id}}" data-kilometros="{{kilometros}}">
                        {{matricula}}
                      </label>
                    </div>
                    {{/each}}
                  </div>
                </div>
              </div>
              <div class="form-group" style="text-align: left;">
                <input type="checkbox" name="socorrista" id="socorrista"/> Socorrista
              </div>
              <div class="form-group" id="comunidadesSelect" style="display: none;">
                <label for="comunidad">Asociar comunidad</label>
                <div class="form-group">
                  <div class="scrollable-label" style="text-align: left; margin-left: 20px;">
                    {{#each comunidadesSelect}}
                    <div class="checkbox">
                      <label>
                        <input type="checkbox" name="comunidad" value="{{nombre}}" data-comunidad="{{nombre}}">
                        {{nombre}}
                      </label>
                    </div>
                    {{/each}}
                  </div>
                </div>
              </div>
              <div class="form-group">
                <button class="btn btn-success">Guardar</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>


  {{!-- TABLA --}}
  <div class="container p-4">
    <div class="row">
      <div class=" mx-auto">
        <div class="card text-center">
          <div class="card-header">
            <div class="card-body">
              <h1>Usuarios registrados</h1>
              <div class="table-responsive">
                <table id="tabla" class="table table-bordered table-striped text-center mt-4">
                  <thead>
                    <tr class="text-white" style="background-color:#6200ee;">
                      <th scope="col">NOMBRE</th>
                      <th scope="col">USUARIO</th>
                      <th scope="col">ADMINISTRADOR</th>
                      <th scope="col">MAQUINISTA</th>
                      <th scope="col">SOCORRISTA</th>
                      <th scope="col">Eliminar</th>
                    </tr>
                  </thead>
                  <tbody>
                    {{#each usuarios}}
                    <tr>
                      <td>
                        <p class="mb-1">{{fullname}}</p>
                      </td>
                      <td>
                        <p class="mb-1">{{username}}</p>
                      </td>
                      <td>
                        <p class="mb-1" id="permisoDeAministracion">{{permisoDeAdministracion}}</p>
                      </td>
                      <td>
                        <p class="mb-1" id="maquinista">{{maquinista}}</p>
                      </td>
                      <td>
                        <p class="mb-1" id="maquinista">{{socorrista}}</p>
                      </td>
                      <td>
                        <a class="btn m-1 fa-solid fa-trash-can" style="font-size: large; color: red;"
                          onclick="confirmar({{id}})"></a>
                      </td>
                    </tr>
                    {{/each}}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!--JQuery y Bootstrap-->
  <script type="text/javascript" src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"
