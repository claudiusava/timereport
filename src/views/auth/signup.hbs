                    left: "thin",
                    right: "thin"
                  },
                  alignment: {
                    vertical: "center",
                    horizontal: "center"
                  }
                },
              },
              {
                cells: "s",
                style: {
                  fill: {
                    pattern: {
                      color: "CACACA"
                    }
                  },
                  border: {
