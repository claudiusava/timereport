<html>

<head>
  <link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css">
  <link rel="stylesheet" type="text/css"
    href="https://cdn.datatables.net/buttons/2.2.2/css/buttons.bootstrap5.min.css" />
  <script src="https://code.jquery.com/jquery-3.6.0.js" integrity="sha256-H+K7U5CnXl1h5ywQfKtSj8PCmoN9aaq30gDh27Xc0jk="
    crossorigin="anonymous"></script>
  <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
  <!--Datatables con Bootstrap-->
  <script type="text/javascript" src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
  <script type="text/javascript" src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
  <!--Para usar los botons-->
  <script type="text/javascript" src="https://cdn.datatables.net/buttons/2.2.2/js/dataTables.buttons.min.js"></script>
  <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jszip/2.5.0/jszip.min.js"></script>
  <script type="text/javascript" src="https://cdn.datatables.net/buttons/2.2.2/js/buttons.html5.min.js"></script>
  <!--Para los estilos en excel-->
  <script
    src="https://cdn.jsdelivr.net/npm/datatables-buttons-excel-styles@1.2.0/js/buttons.html5.styles.min.js"></script>
  <script
    src="https://cdn.jsdelivr.net/npm/datatables-buttons-excel-styles@1.2.0/js/buttons.html5.styles.templates.min.js"></script>
  <style>
    .foto {
      max-width: 100%;
      max-height: 200px;
      cursor: pointer;
      border-radius: 5%;
      transition: transform 0.5s ease;
    }

    .foto.agrandada {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) scale(3);
      z-index: 1000;
    }

    .fondo-ampliado {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0, 0, 0, 0.8);
      /* Fondo semi-transparente */
      z-index: 999;
      /* Por debajo de la imagen ampliada */
    }
  </style>
</head>

<body>
  {{!-- CARD INSERT --}}
  <div class="container p-4">
    <div class="row">
      <div class="col-md-4 mx-auto">
        <div class="card text-center">
          <div class="card-header">
            <strong>
              Control de calidad del agua.
            </strong>
          </div>
          <div class="card-body">
            <form action="/imputaciones/calidadAgua/add" method="POST" id="formNuevoControlAgua">
              <div class="form-group">
                <select name="piscina" class="form-control" id="selector" required>
                  <option></option>
                  {{#each comunidades}}
                  <option value="{{nombre}}">{{nombre}}</option>
                  {{/each}}
                </select>
              </div>
              <div class="form-group">
                <select class="form-control" id="nivelCloro" name="nivelCloro" required>
                  <option value="" disabled selected>Cloro libre</option>
                  <option style="background-color: #FDEFF3;">0.5</option>
                  <option style="background-color: #FBC8D9;">1.0</option>
                  <option style="background-color: #F89CBF;">1.5</option>
                  <option style="background-color: #F570A5;">2.0</option>
                  <option style="background-color: #F3448B;">3.0</option>
                  <option style="background-color: #F11971;">5.0</option>
                </select>
              </div>
              <div class="form-group">
                <select class="form-control" id="nivelPH" name="nivelPh" required>
                  <option value="" disabled selected>PH</option>
                  <option style="background-color: #FFB366;">6.8</option>
                  <option style="background-color: #FFA74D;">7.0</option>
                  <option style="background-color: #FF9933;">7.2</option>
                  <option style="background-color: #FF8C1A;">7.4</option>
                  <option style="background-color: #FF8000;">7.6</option>
                  <option style="background-color: #FF7300;">8.0</option>
                </select>
              </div>
              <div class="form-group">
                <input name="numeroBanistas" class="form-control" placeholder="Número de bañistas" type="number"
                  required min="0" max="500">
              </div>
              <div class="form-group">
                <input name="nivelRebosadero" class="form-control" placeholder="Nivel de rebosadero" type="number"
                  required min="0" max="1000000">
              </div>
              <div class="form-group">
                <input name="aguaDepurada" class="form-control" placeholder="Agua depurada (M³)" type="number" required
                  min="0" max="1000000">
              </div>
              <div class="form-group">
                <input id="inp" type="file" accept="image/*" capture="camera" placeholder="foto" required>
                <input type="hidden" id="b64" value="" name="foto">
                <br>
                <img id="img" style="border-radius: 5%;">
              </div>
              <div class="form-group">
                <button class="btn btn-success">Guardar</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
    <br>
    {{!-- REGISTROS DEL PROPIO USUARIO --}}
    <div>
      {{#each controlagua}}
      <div class="list-group">
        <div class="list-group-item list-group-item-action flex-column align-items-start"
          style="background-color: rgb(202, 202, 202); border-color: black;">
          <div>
            <div>
              <p class="mb-1"><b>Fecha: </b>{{formatted_created_at}}</p>
              <p class="mb-1"><b>Piscina: </b>{{piscina}}</p>
              <p class="mb-1"><b>Cloro libre: </b>{{nivelCloro}}</p>
              <p class="mb-1"><b>PH: </b>{{nivelPh}}</p>
              <p class="mb-1"><b>Número de bañistas: </b>{{numeroBanistas}}</p>
              <p class="mb-1"><b>Nivel de rebosadero: </b>{{nivelRebosadero}}</p>
              <p class="mb-1"><b>Agua depurada (M³): </b>{{aguaDepurada}}</p>
              <p class="mb-1"><b>Foto medidor: </b><img src="data:image/jpg;base64,{{foto}}" alt="Foto del medidor"
                  style="max-width: 100px; max-height: 100px; border-radius: 5%;" class="foto" onclick="ampliar(this)">
              </p>
            </div>
          </div>
          <div class="w-100 text-right">
            <a class="btn m-1 fa-solid fa-trash-can" style="font-size: large; color: red;"
              onclick="confirmar({{id}})"></a>
          </div>
        </div>
      </div>
      {{else}}
      <div class="col-4 mx-auto">
        <div class="card card-body text-center">
          <p>¡Todavía no tienes ningún registro guardado!</p>
        </div>
      </div>
      {{/each}}
    </div>
  </div>

  <script>
    // Función para el pop-up de eliminar el registro
    function confirmar(id) {
      Swal.fire({
        title: '¿Seguro que quieres eliminar este registro?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Eliminar',
        confirmButtonColor: '#d63030',
        focusConfirm: 'true'
      }).then((result) => {
        if (result.isConfirmed) {
          window.location = '/imputaciones/calidadAgua/delete/' + id;
        }
      })
    }

    // Función para colorear el fondo del select de nivel de cloro
    const selectElementCloro = document.getElementById('nivelCloro');
    selectElementCloro.addEventListener('change', function () {
      const selectedOptionCloro = this.options[this.selectedIndex];
      const colorCloro = selectedOptionCloro.style.backgroundColor;
      this.style.backgroundColor = colorCloro;
    });

    // Función para colorear el fondo del select de nivel de PH
    const selectElementPH = document.getElementById('nivelPH');
    selectElementPH.addEventListener('change', function () {
      const selectedOptionPH = this.options[this.selectedIndex];
      const colorPH = selectedOptionPH.style.backgroundColor;
      this.style.backgroundColor = colorPH;
    });

    // Función para ampliar una imagen al hacer click sobre ella
    function ampliar(img) {
      img.classList.toggle('agrandada');
      if (img.classList.contains('agrandada')) {
        // Crear un div para el fondo semi-transparente
        var fondo = document.createElement('div');
        fondo.className = 'fondo-ampliado';
        // Agregar el fondo antes de la imagen ampliada en el DOM
        img.parentNode.insertBefore(fondo, img);
        // Escuchar clics en el fondo y en la imagen para cerrar la imagen ampliada
        fondo.addEventListener('click', cerrarAmpliada);
        img.addEventListener('click', cerrarAmpliada);
      } else {
        // Quitar el fondo semi-transparente
        var fondo = document.querySelector('.fondo-ampliado');
        fondo.parentNode.removeChild(fondo);
      }
    }

    // Función para devolver imagen a tamaño original
    function cerrarAmpliada(event) {
      // Verificar si el clic ocurrió en el fondo semi-transparente
      if (event.target.classList.contains('fondo-ampliado')) {
        // Obtener la imagen ampliada y cerrarla
        var imgAmpliada = document.querySelector('.foto.agrandada');
        imgAmpliada.classList.remove('agrandada');
        // Quitar el fondo semi-transparente
        var fondo = document.querySelector('.fondo-ampliado');
        fondo.parentNode.removeChild(fondo);
      }
    }

    var initSelector = jQuery.noConflict();
    initSelector(document).ready(function () {
      if (initSelector("#selector").length > 0) {
        initSelector('#selector').select2({
          placeholder: 'Selecciona una comunidad',
          allowClear: true,
          language: {
            noResults: function () {
              return "No hay resultados";
            },
            searching: function () {
              return "Buscando...";
            }
          }
        });
      } else {
        console.log("No existe selector");
      }
    });


    function readFile() {
      if (!this.files || !this.files[0]) return;
      const FR = new FileReader();
      FR.addEventListener("load", function (evt) {
        document.querySelector("#img").src = evt.target.result;
        document.querySelector("#b64").value = evt.target.result;
        document.querySelector("#img").height = 150;
      });
      FR.readAsDataURL(this.files[0]);
    }

    document.querySelector("#inp").addEventListener("change", readFile);
  </script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.9/dist/sweetalert2.all.min.js"></script>
</body>

</html>