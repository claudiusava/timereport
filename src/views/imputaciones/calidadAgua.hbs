<html>

<head>
  <link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css">
  <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/buttons/2.2.2/css/buttons.bootstrap5.min.css" />
  <script src="https://code.jquery.com/jquery-3.6.0.js" integrity="sha256-H+K7U5CnXl1h5ywQfKtSj8PCmoN9aaq30gDh27Xc0jk=" crossorigin="anonymous"></script>
  <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
</head>

<body>
  <div class="container p-4">
    <div class="row">
      <div class="col-md-4 mx-auto">
        <div class="card text-center">
          <div class="card-header">
            <strong>
              Añade registro para control de calidad del agua.
            </strong>
          </div>
          <div class="card-body">
            <form action="/imputaciones/calidadAgua/add" method="POST">
                <div class="form-group">
                    <input readonly type="datetime-local" class="form-control" name="fecha" placeholder="fechaActualizacion" aria-label="Default select example" required>
                </div>
                <div class="form-group">
                  <select name="piscina" class="form-control" id="selector" required>
                    <option></option>
                    {{#each comunidades}}
                    <option value="{{nombre}}">{{nombre}}</option>
                    {{/each}}
                  </select>
                </div>
                <div class="form-group">
                  <select class="form-control" id="nivelPH" name="nivelPh">
                    <option value="" disabled selected>Nivel de PH</option>
                    <option style="background-color: #FFB366;">6.8</option>
                    <option style="background-color: #FFA74D;">7.0</option>
                    <option style="background-color: #FF9933;">7.2</option>
                    <option style="background-color: #FF8C1A;">7.4</option>
                    <option style="background-color: #FF8000;">7.6</option>
                    <option style="background-color: #FF7300;">8.0</option>
                  </select>
                </div>
                <div class="form-group">
                  <select class="form-control" id="nivelCloro" name="nivelCloro">
                    <option value="" disabled selected>Nivel de Cloro</option>
                    <option style="background-color: #FDEFF3;">0.5</option>
                    <option style="background-color: #FBC8D9;">1.0</option>
                    <option style="background-color: #F89CBF;">1.5</option>
                    <option style="background-color: #F570A5;">2.0</option>
                    <option style="background-color: #F3448B;">3.0</option>
                    <option style="background-color: #F11971;">5.0</option>
                  </select>
                </div>
                <div class="form-group">
                  <button class="btn btn-success">Guardar</button>
                </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="container p-4">
    <div class="row">
      <div class=" mx-auto">
        <div class="card text-center">
          <div class="card-header">
            <div class="card-body">
              <h1>Comunidades guardadas</h1>
              <div class="table-responsive">
              <table id="tabla" class="table table-bordered table-striped text-center mt-4">
                <thead>
                  <tr class="text-white" style="background-color:#6200ee;">
                    <th scope="col">FECHA Y HORA</th>
                    <th scope="col">PISCINA</th>
                    <th scope="col">NIVEL DE PH</th>
                    <th scope="col">NIVEL DE CLORO</th>
                    <th scope="col">Eliminar</th>
                  </tr>
                </thead>
                <tbody>
                  {{#each controlagua}}
                  <tr>
                    <td>
                      <p class="mb-1">{{fecha}}</p>
                    </td>
                    <td>
                      <p class="mb-1">{{piscina}}</p>
                    </td>
                    <td>
                      <p class="mb-1">{{nivelPh}}</p>
                    </td>
                    <td>
                      <p class="mb-1">{{nivelCloro}}</p>
                    </td>
                    <td>
                      <a class="btn m-1 fa-solid fa-trash-can" style="font-size: large; color: red;"
                        onclick="confirmar({{id}})"></a>
                    </td>
                  </tr>
                  {{/each}}
                </tbody>
              </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script>
    const selectElementPH = document.getElementById('nivelPH');
    selectElementPH.addEventListener('change', function() {
    const selectedOptionPH = this.options[this.selectedIndex];
    const colorPH = selectedOptionPH.style.backgroundColor;
    this.style.backgroundColor = colorPH;
    });

    const selectElementCloro = document.getElementById('nivelCloro');
    selectElementCloro.addEventListener('change', function() {
    const selectedOptionCloro = this.options[this.selectedIndex];
    const colorCloro = selectedOptionCloro.style.backgroundColor;
    this.style.backgroundColor = colorCloro;
    });

    var fechaInput = document.querySelector('input[name="fecha"]');
      var fechaActual = new Date();
      var horas = fechaActual.getHours().toString().padStart(2, '0');
      var minutos = fechaActual.getMinutes().toString().padStart(2, '0');
      var fechaHoraActual = fechaActual.toISOString().split('T')[0] + 'T' + horas + ':' + minutos;
        fechaInput.value = fechaHoraActual;
      var fechaInputNuevo = document.querySelector('#formVehiculoNuevo input[name="fecha"]');
        fechaInputNuevo.value = fechaHoraActual;
  </script>


  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.9/dist/sweetalert2.all.min.js"></script>

  <script>
    var initSelector = jQuery.noConflict();
        initSelector(document).ready(function() {
            if(initSelector("#selector").length > 0){
                initSelector('#selector').select2({
                    placeholder: 'Selecciona una comunidad',
                    allowClear: true,
                    language: {
                        noResults: function(){
                            return "No hay resultados";
                        },
                        searching: function(){
                            return "Buscando...";
                        }
                    }
                });
                }else{
                    console.log("No existe selector");
                }
            });

    function confirmar(id) {
      Swal.fire({
        title: '¿Seguro que quieres eliminar este registro?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Eliminar',
        confirmButtonColor: '#d63030',
        focusConfirm: 'true'
      }).then((result) => {
        if (result.isConfirmed) {
          window.location = '/imputaciones/calidadAgua/delete/' + id;
        }
      })
    }
  </script>

