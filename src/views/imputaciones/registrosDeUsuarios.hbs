<!DOCTYPE html>
<html>

<head>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" type="text/css"
        href="https://cdn.datatables.net/buttons/2.2.2/css/buttons.bootstrap5.min.css" />
    <!--JQuery y Bootstrap-->
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.9/dist/sweetalert2.all.min.js"></script>
    <!--Datatables con Bootstrap-->
    <script type="text/javascript" src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script type="text/javascript" src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
    <!--Para usar los botons-->
    <script type="text/javascript" src="https://cdn.datatables.net/buttons/2.2.2/js/dataTables.buttons.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jszip/2.5.0/jszip.min.js"></script>
    <script type="text/javascript" src="https://cdn.datatables.net/buttons/2.2.2/js/buttons.html5.min.js"></script>
    <!--Para los estilos en excel-->
    <script
        src="https://cdn.jsdelivr.net/npm/datatables-buttons-excel-styles@1.2.0/js/buttons.html5.styles.min.js"></script>
    <script
        src="https://cdn.jsdelivr.net/npm/datatables-buttons-excel-styles@1.2.0/js/buttons.html5.styles.templates.min.js"></script>
</head>

<body>
    <div class="container">
        <div class="container p-4">
            <div class="table-responsive">
                <select id="tablaSelector" onchange="mostrarTabla()" class="form-control">
                    <option value="tabla" selected>Horas de trabajo</option>
                    <option value="tabla1">Kilometraje de furgonetas</option>
                    <option value="tabla2">Controles de calidad de agua</option>
                </select>
                <br>
                {{!-- TABLA HORAS DE TRABAJO --}}
                <table id="tabla" class="table table-bordered table-striped text-center mt-4">
                    <thead>
                        <tr class="text-white" style="background-color:#6200ee;">
                            <th scope="col">TRABAJADOR</th>
                            <th scope="col">CREACIÓN DEL REGISTRO</th>
                            <th scope="col">FECHA</th>
                            <th scope="col">COMUNIDAD</th>
                            <th scope="col">HORAS TRABAJADAS</th>
                            <th scope="col">HORAS TRABAJADAS (formato numérico)</th>
                            <th scope="col">Eliminar</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each imputaciones}}
                        <tr>
                            <td>
                                <p class="mb-1">{{fullname}}</p>
                            </td>
                            <td>
                                <p class="mb-1">{{fechaCreacionFormateada}}</p>
                            </td>
                            <td>
                                <p class="mb-1">{{fechaFormateada}}</p>
                            </td>
                            <td>
                                <p class="mb-1">{{comunidad}}</p>
                            </td>
                            <td>
                                <p class="mb-1">{{horas}}:{{minutos}}</p>
                            </td>
                            <td>
                                <p class="mb-1">{{horas}}:{{minutosFormateados}}</p>
                            </td>
                            <td>
                                <a class="btn m-1 fa-solid fa-trash-can" style="font-size: large; color: red;"
                                    onclick="confirmarBorrarHoras({{id}})"></a>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
                {{!-- TABLA FURGONETAS --}}
                <table id="tabla1" class="table table-bordered table-striped text-center mt-4">
                    <thead>
                        <tr class="text-white" style="background-color:#6200ee;">
                            <th scope="col">FECHA</th>
                            <th scope="col">MATRÍCULA</th>
                            <th scope="col">KILÓMETROS</th>
                            <th scope="col">Eliminar</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each vehiculos}}
                        <tr>
                            <td>
                                <p class="mb-1">{{fechaActualizacionFormateada}}</p>
                            </td>
                            <td>
                                <p class="mb-1">{{matricula}}</p>
                            </td>
                            <td>
                                <p class="mb-1">{{kilometros}}</p>
                            </td>
                            <td>
                                <a class="btn m-1 fa-solid fa-trash-can" style="font-size: large; color: red;"
                                    onclick="confirmarBorrarKm({{id}})"></a>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
                {{!-- TABLA CONTROL DE CALIDAD DEL AGUA --}}
                <table id="tabla2" class="table table-bordered table-striped text-center mt-4">
                    <thead>
                        <tr class="text-white" style="background-color:#6200ee;">
                            <th scope="col">FECHA</th>
                            <th scope="col">PISCINA</th>
                            <th scope="col">NIVEL DE PH</th>
                            <th scope="col">NIVEL DE CLORO</th>
                            <th scope="col">NÚMERO DE BAÑISTAS</th>
                            <th scope="col">Eliminar</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each controlagua}}
                        <tr>
                            <td>
                                <p class="mb-1">{{fechaFormateada}}</p>
                            </td>
                            <td>
                                <p class="mb-1">{{piscina}}</p>
                            </td>
                            <td>
                                <p class="mb-1">{{nivelPh}}</p>
                            </td>
                            <td>
                                <p class="mb-1">{{nivelCloro}}</p>
                            </td>
                            <td>
                                <p class="mb-1">{{numeroBanistas}}</p>
                            </td>
                            <td>
                                <a class="btn m-1 fa-solid fa-trash-can" style="font-size: large; color: red;"
                                    onclick="confirmarBorrarControlAgua({{id}})"></a>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>


        <script>
            // Función para borrar horas trabajadas
            function confirmarBorrarHoras(id) {
                Swal.fire({
                    title: '¿Seguro que quieres eliminar este registro?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Eliminar',
                    confirmButtonColor: '#d63030',
                    focusConfirm: 'true'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location = '/imputaciones/registrosDeUsuarios/deleteHoras/' + id;
                    }
                })
            }

            // Función para borrar registros de furgonetas
            function confirmarBorrarKm(id) {
                Swal.fire({
                    title: '¿Seguro que quieres eliminar este registro?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Eliminar',
                    confirmButtonColor: '#d63030',
                    focusConfirm: 'true'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location = '/imputaciones/registrosDeUsuarios/deleteKm/' + id;
                    }
                })
            }

            // Función para borrar controles de calidad de agua
            function confirmarBorrarControlAgua(id) {
                Swal.fire({
                    title: '¿Seguro que quieres eliminar este registro?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Eliminar',
                    confirmButtonColor: '#d63030',
                    focusConfirm: 'true'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location = '/imputaciones/registrosDeUsuarios/deleteControlAgua/' + id;
                    }
                })
            }

            // Configuración de las tablas 
            var configTables = {
                lengthMenu: [
                    [10, 25, 50, 100, -1],
                    ['10', '25', '50', '100', 'todos']
                ],
                dom: "Bflrtip",
                buttons: {
                    dom: {
                        button: {
                            className: 'btn'
                        }
                    },
                    buttons: [
                        {
                            extend: "excel",
                            text: 'Exportar a excel',
                            className: 'btn btn-success',
                            margin: '100px',
                            exportOptions: {
                                columns: ":not(:last-child)"
                            },
                            excelStyles: [
                                {
                                    cells: "sh",
                                    style: {
                                        font: {
                                            name: "Arial",
                                            size: "12",
                                            color: "FFFFFF",
                                            b: true
                                        },
                                        fill: {
                                            pattern: {
                                                color: "6200ee",
                                            }
                                        },
                                        border: {
                                            top: "thin",
                                            bottom: "thin",
                                            left: "thin",
                                            right: "thin"
                                        },
                                        alignment: {
                                            vertical: "center",
                                            horizontal: "center"
                                        }
                                    },
                                },
                                {
                                    cells: "s",
                                    style: {
                                        fill: {
                                            pattern: {
                                                color: "CACACA"
                                            }
                                        },
                                        border: {
                                            top: "thin",
                                            bottom: "thin",
                                            left: "thin",
                                            right: "thin"
                                        }
                                    }
                                },
                                {
                                    cells: "sB",
                                    style: {
                                        alignment: {
                                            vertical: "center",
                                            horizontal: "center"
                                        }
                                    }
                                },
                                {
                                    cells: "sD",
                                    style: {
                                        alignment: {
                                            vertical: "center",
                                            horizontal: "center",
                                        },
                                        fill: {
                                            width: "50"
                                        }
                                    }
                                },
                                {
                                    cells: "sE",
                                    style: {
                                        alignment: {
                                            vertical: "center",
                                            horizontal: "center"
                                        }
                                    }
                                }
                            ]
                        }
                    ]
                }
            };

            // Lógica para que al cargar o recargar la página sólo aparezca la primera
            var tableConfigurations = {
                tabla1: {
                    configId: 'tabla',
                    display: true
                },
                tabla2: {
                    configId: 'tabla1',
                    display: false
                },
                tabla3: {
                    configId: 'tabla2',
                    display: false
                }
            };
            var currentTable;

            var initSelector = jQuery.noConflict();

            document.addEventListener("DOMContentLoaded", function () {
                // Inicializa DataTables en todas las tablas
                var tablas = document.getElementsByTagName("table");
                for (var i = 0; i < tablas.length; i++) {
                    initSelector(tablas[i]).DataTable(configTables);

                for (var tableName in tableConfigurations) {
                    var config = tableConfigurations[tableName];
                    var configElement = document.getElementById(config.configId);
                    if (config.display) {
                        configElement.style.display = "block";
                        currentTable = '#' + tableName;
                    } else {
                        configElement.style.display = "none";
                    }
                }
            });

            function mostrarTabla() {
                var selector = document.getElementById("tablaSelector");
                var tablaSeleccionada = selector.value;

                // Oculta todas las tablas
                var tablas = document.getElementsByTagName("table");
                for (var i = 0; i < tablas.length; i++) {
                    tablas[i].style.display = "none";
                }

                // Muestra la tabla seleccionada
                var tablaMostrar = document.getElementById(tablaSeleccionada);
                tablaMostrar.style.display = "block";

                // Si ya se ha inicializado la tabla seleccionada, simplemente vuelva a dibujarla
                if ($.fn.DataTable.isDataTable('#' + tablaSeleccionada)) {
                    $('#' + tablaSeleccionada).DataTable().draw();
                } else {
                    // Inicializa la tabla seleccionada
                    $('#' + tablaSeleccionada).DataTable(configTables);
                }

                currentTable = '#' + tablaSeleccionada;
            }



        </script>
</body>

</html>