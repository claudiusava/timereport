<!DOCTYPE html>
<html lang="en">

<head>
  <script src="https://code.jquery.com/jquery-3.6.0.js" integrity="sha256-H+K7U5CnXl1h5ywQfKtSj8PCmoN9aaq30gDh27Xc0jk=" crossorigin="anonymous"></script>
  <link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css">
  <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/buttons/2.2.2/css/buttons.bootstrap5.min.css" />
  <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
  <!--JQuery y Bootstrap-->
  <script type="text/javascript" src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.9/dist/sweetalert2.all.min.js"></script>
  <!--Datatables con Bootstrap-->
  <script type="text/javascript" src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
  <script type="text/javascript" src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
  <!--Para usar los botons-->
  <script type="text/javascript" src="https://cdn.datatables.net/buttons/2.2.2/js/dataTables.buttons.min.js"></script>
  <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jszip/2.5.0/jszip.min.js"></script>
  <script type="text/javascript" src="https://cdn.datatables.net/buttons/2.2.2/js/buttons.html5.min.js"></script>
  <!--Para los estilos en excel-->
  <script src="https://cdn.jsdelivr.net/npm/datatables-buttons-excel-styles@1.2.0/js/buttons.html5.styles.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/datatables-buttons-excel-styles@1.2.0/js/buttons.html5.styles.templates.min.js"></script>
</head>

<body>
  {{!-- CARD INSERT --}}
  <div class="container p-4">
    <div class="row">
      <div class="col-md-4 mx-auto">
        <div class="card text-center">
          <div class="card-header">
            <strong>Registra los kilómetros de tu furgoneta.</strong>
          </div>
          <div class="card-body">
            {{#if user.permisoDeAdministracion}}
            <div class="form-group">
              <div class="label-container">
                <span id="labelVehiculoNuevo">Furgoneta nueva.</span>
                <label class="switch">
                  <input type="checkbox" id="checkboxVehiculoNuevo">
                  <span class="slider round"></span>
                </label>
                <span id="labelVehiculoExistente">Furgoneta existente.</span>
              </div>
            </div>
            {{/if}}
            <form action="/imputaciones/registrarKilometros" method="POST" id="formVehiculoExistente">
              <div class="form-group">
                <input readonly type="datetime-local" class="form-control" name="fechaActualizacion"
                  aria-label="Default select example" required>
              </div>
              <div class="form-group">
                <select name="vehiculo" class="form-control" id="selector" required>
                  <option value="" disabled selected>Seleccione una furgoneta</option>
                  {{#each vehiculosSelect}}
                  <option value="{{matricula}}" data-kilometros="{{kilometros}}">{{matricula}}</option>
                  {{/each}}
                </select>
              </div>
              <div class="form-group">
                <input class="form-control" type="number" placeholder="Kilómetros" min="{{vehiculo.kilometros}}"
                  name="kilometros" required>
              </div>
              <input type="hidden" name="matricula" id="matriculaInputExistente">
              <div class="form-group">
                <button class="btn btn-success">Guardar</button>
              </div>
            </form>
            {{#if user.permisoDeAdministracion}}
            <form action="/imputaciones/registrarKilometros" method="POST" id="formVehiculoNuevo">
              <div class="form-group">
                <input readonly type="datetime-local" class="form-control" name="fechaActualizacion"
                  aria-label="Default select example" required>
              </div>
              <div class="form-group">
                <input type="text" class="form-control" name="matricula" id="matriculaInput" placeholder="Matrícula"
                  required>
                <span id="matriculaError" style="color: red;"></span>
              </div>
              <div class="form-group">
                <input class="form-control" type="number" placeholder="Kilómetros" min="0" name="kilometros" required>
              </div>
              <div class="form-group">
                <button class="btn btn-success" id="guardarVehiculoNuevo">Guardar</button>
              </div>
            </form>
            {{/if}}
          </div>
        </div>
      </div>
    </div>
    <br>
    {{!-- REGISTROS DEL PROPIO USUARIO --}}
    <div>
      {{#each vehiculos}}
      <div class="list-group">
        <div class="list-group-item list-group-item-action flex-column align-items-start"
          style="background-color: rgb(202, 202, 202); border-color: black;">
          <div>
            <div>
              <p class="mb-1"><b>Matricula: </b>{{matricula}}</p>
              <p class="mb-1"><b>Fecha: </b>{{fechaActualizacionFormateada}}</p>
              <p class="mb-1"><b>Kilometros: </b>{{kilometros}}</p>
            </div>
          </div>
          <div class="w-100 text-right">
            <a class="btn m-1 fa-solid fa-trash-can" style="font-size: large; color: red;"
              onclick="confirmar({{id}})"></a>
          </div>
        </div>
      </div>
      {{else}}
      <div class="col-4 mx-auto">
        <div class="card card-body text-center">
          <p>¡Todavía no tienes ningún registro guardado!</p>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</body>

<script>
  function confirmar(id) {
    Swal.fire({
      title: '¿Seguro que quieres eliminar esta furgoneta?',
      icon: 'warning',
      showCancelButton: true,
      confirmButtonText: 'Eliminar',
      confirmButtonColor: '#d63030',
      focusConfirm: 'true'
    }).then((result) => {
      if (result.isConfirmed) {
        window.location = '/imputaciones/registrarKilometros/delete/' + id;
      }
    })
  }
</script>
<script>
  var selectElement = document.getElementById('selector');
  var defaultOption = selectElement.querySelector('option[value=""]');
  selectElement.addEventListener('change', function () {
    if (selectElement.value !== '') {
      defaultOption.disabled = true;
      defaultOption.remove();
    }

    const selectedOption = selectElement.options[selectElement.selectedIndex];
    const matricula = selectedOption.value;
    document.getElementById('matriculaInputExistente').value = matricula;

    const kilometros = parseInt(selectedOption.getAttribute('data-kilometros')) || 0;
    document.getElementsByName('kilometros')[0].min = kilometros + 1;
    document.getElementsByName('kilometros')[0].value = kilometros;
  });

  var fechaInput = document.querySelector('input[name="fechaActualizacion"]');
  var fechaActual = new Date();
  var horas = fechaActual.getHours().toString().padStart(2, '0');
  var minutos = fechaActual.getMinutes().toString().padStart(2, '0');
  var fechaHoraActual = fechaActual.toISOString().split('T')[0] + 'T' + horas + ':' + minutos;
  fechaInput.value = fechaHoraActual;
  var fechaInputNuevo = document.querySelector('#formVehiculoNuevo input[name="fechaActualizacion"]');
  fechaInputNuevo.value = fechaHoraActual;

  var checkboxVehiculoNuevo = document.getElementById('checkboxVehiculoNuevo');
  var formVehiculoExistente = document.getElementById('formVehiculoExistente');
  var formVehiculoNuevo = document.getElementById('formVehiculoNuevo');
  var labelVehiculoNuevo = document.getElementById('labelVehiculoNuevo');
  var labelVehiculoExistente = document.getElementById('labelVehiculoExistente');

  checkboxVehiculoNuevo.addEventListener('change', function () {
    if (this.checked) {
      formVehiculoExistente.style.display = 'block';
      formVehiculoNuevo.style.display = 'none';
      labelVehiculoNuevo.style.fontWeight = 'normal';
      labelVehiculoExistente.style.fontWeight = 'bold';
    } else {
      formVehiculoExistente.style.display = 'none';
      formVehiculoNuevo.style.display = 'block';
      labelVehiculoNuevo.style.fontWeight = 'bold';
      labelVehiculoExistente.style.fontWeight = 'normal';
    }
  });

  formVehiculoExistente.style.display = 'none';
  labelVehiculoNuevo.style.fontWeight = 'bold';

  var inputKilometros = document.getElementsByName('kilometros')[0];
  var valorInicial = parseInt(inputKilometros.getAttribute('min')) || 0;

  inputKilometros.addEventListener('input', function () {
    var valorActual = parseInt(inputKilometros.value) || 0;
    if (valorActual <= valorInicial) {
      inputKilometros.value = valorInicial;
    }
  });

  document.getElementById('guardarVehiculoNuevo').addEventListener('click', function (e) {
    e.preventDefault();

    var matriculaInput = document.getElementById('matriculaInput');
    var matricula = matriculaInput.value.trim();
    var matriculaError = document.getElementById('matriculaError');

    if (matricula === '') {
      matriculaError.textContent = 'Debe ingresar una matrícula.';
      return;
    }

    matriculaError.textContent = '';

    var select = document.getElementById('selector');
    var options = select.options;

    for (let i = 0; i < options.length; i++) {
      if (options[i].value === matricula) {
        matriculaError.textContent = 'Ya existe una furgoneta con esa matrícula.';
        return;
      }
    }

    formVehiculoNuevo.submit();
  });
</script>
</body>
</html>