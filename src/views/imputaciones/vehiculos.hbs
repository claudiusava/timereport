<!DOCTYPE html>
<html lang="en">

<head>
  <script src="https://code.jquery.com/jquery-3.6.0.js" integrity="sha256-H+K7U5CnXl1h5ywQfKtSj8PCmoN9aaq30gDh27Xc0jk="
    crossorigin="anonymous"></script>
  <link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css">
  <link rel="stylesheet" type="text/css"
    href="https://cdn.datatables.net/buttons/2.2.2/css/buttons.bootstrap5.min.css" />
  <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
  <!--JQuery y Bootstrap-->
  <script type="text/javascript" src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p"
    crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.9/dist/sweetalert2.all.min.js"></script>
  <!--Datatables con Bootstrap-->
  <script type="text/javascript" src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
  <script type="text/javascript" src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
  <!--Para usar los botons-->
  <script type="text/javascript" src="https://cdn.datatables.net/buttons/2.2.2/js/dataTables.buttons.min.js"></script>
  <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jszip/2.5.0/jszip.min.js"></script>
  <script type="text/javascript" src="https://cdn.datatables.net/buttons/2.2.2/js/buttons.html5.min.js"></script>
  <!--Para los estilos en excel-->
  <script
    src="https://cdn.jsdelivr.net/npm/datatables-buttons-excel-styles@1.2.0/js/buttons.html5.styles.min.js"></script>
  <script
    src="https://cdn.jsdelivr.net/npm/datatables-buttons-excel-styles@1.2.0/js/buttons.html5.styles.templates.min.js"></script>
</head>

<body>
  {{!-- CARD INSERT --}}
  <div class="container p-4">
    <div class="row">
      <div class="col-md-4 mx-auto">
        <div class="card text-center">
          <div class="card-header">
            <strong>Añade un nuevo vehículo.</strong>
          </div>
          <div class="card-body">
            <div class="form-group">
            </div>
            <form action="/imputaciones/vehiculos" method="POST" id="formVehiculoNuevo">
              <div class="form-group">
                <input type="text" class="form-control" name="matricula" id="matriculaInput" placeholder="Matrícula" required>
                <span id="matriculaError" style="color: red;"></span>
              </div>
              <div class="form-group">
                <button type="submit" class="btn btn-success" id="guardarVehiculoNuevo">Guardar</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="container p-4">
    <div class="row">
      <div class=" mx-auto">
        <div class="card text-center">
          <div class="card-header">
            <div class="card-body">
              <h1>Vehículos guardadas</h1>
              <div class="table-responsive">
                <table id="tablaVehiculos" class="table table-bordered table-striped text-center mt-4">
                  <thead>
                    <tr class="text-white" style="background-color:#6200ee;">
                      <th scope="col">GUARDADO POR</th>
                      <th scope="col">MATRÍCULA</th>
                      <th scope="col">FECHA CREACIÓN</th>
                      <th scope="col">Eliminar</th>
                    </tr>
                  </thead>
                  <tbody>
                    {{#each vehiculos}}
                    <tr data-matricula="{{matricula}}">
                      <td>
                        <p class="mb-1">{{fullname}}</p>
                      </td>
                      <td>
                        <p class="mb-1">{{matricula}}</p>
                      </td>
                      <td>
                        <p class="mb-1">{{formatted_created_at}}</p>
                      </td>
                      <td>
                        <a class="btn m-1 fa-solid fa-trash-can" style="font-size: large; color: red;"
                          onclick="confirmar({{id_vehiculo}})"></a>
                      </td>
                    </tr>
                    {{/each}}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>

<script>
  function confirmar(id_vehiculo) {
    Swal.fire({
      title: '¿Seguro que quieres eliminar esta furgoneta?',
      icon: 'warning',
      showCancelButton: true,
      confirmButtonText: 'Eliminar',
      confirmButtonColor: '#d63030',
      focusConfirm: 'true'
    }).then((result) => {
      if (result.isConfirmed) {
        window.location = '/imputaciones/vehiculos/delete/' + id_vehiculo;
      }
    })
  }


  document.getElementById('guardarVehiculoNuevo').addEventListener('submit', async function (e) {
    e.preventDefault();

    var matriculaInput = document.getElementById('matriculaInput');
    var matricula = matriculaInput.value.trim();
    var matriculaError = document.getElementById('matriculaError');

    // Obtener todas las filas de la tabla
    var filasTabla = document.querySelectorAll('#tablaVehiculos tbody tr');

    var comunidadesBBDD = [];

    filasTabla.forEach(function (fila) {
      var codigo = fila.getAttribute('data-matricula');
      comunidadesBBDD.push(codigo);
    });

    matriculaError.textContent = '';

    // Verificar si el código ya existe en el objeto 'comunidadesBBDD'
    var codigoExiste = comunidadesBBDD.some(function (codigo) {
      return codigo === matricula;
    });

    if (codigoExiste) {
      matriculaError.textContent = 'Ya existe un vehículo con esa matrícula.';
    } else {
      this.submit();
    }
  });

</script>
</body>

</html>