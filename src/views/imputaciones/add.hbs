<!DOCTYPE html>
<html lang="en">

<head>
    <script src="https://code.jquery.com/jquery-3.6.0.js"
        integrity="sha256-H+K7U5CnXl1h5ywQfKtSj8PCmoN9aaq30gDh27Xc0jk=" crossorigin="anonymous"></script>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <style>
        .select2-container {
            min-width: 0 !important;
        }
    </style>
</head>

<body>
    <div class="container p-4">
        <div class="row">
            <div class="col-md-4 mx-auto">
                <div class="alert alert-danger alert-dismissible col-md-12" id="alertLoc" role="alert" style="display: none;">
                    <strong>¡Alerta! -</strong> No puedes fichar a tanta distancia de la comunidad
                    <button type="button" class="btn-close" data-bs-dismiss="alert" onclick="$('#alertLoc').hide()"></button>
                </div>
                <div>
                    {{#each imputaciones}}
                    <div class="imputaciones" data-fecha="{{created_at}}" data-tipo="{{isEntrada}}"></div>
                    {{/each}}
                </div>
                <div class="card text-center">
                    <div class="card-header">
                        <strong>
                            Fichaje.
                        </strong>
                    </div>
                    <div class="card-body">
                        <form id="add" action="/imputaciones/add" method="POST">
                            <div class="form-group">
                                <select name="comunidad" class="form-control" id="selector" required>
                                    <option></option>
                                    {{#each comunidades}}
                                    <option value="{{nombre}}" data-coords="{{coordenadas}}">{{nombre}}</option>
                                    {{/each}}
                                </select>
                            </div>
                            <div class="form-group">
                                <input type="hidden" id="fecha" name="fecha" value="">
                                <input type="hidden" id="horas" name="horas" value="">
                                <input type="hidden" id="minutos" name="minutos" value="">
                                <input type="hidden" id="isEntrada" name="isEntrada" value="true">
                            </div>
                            <!-- Label para mostrar la fecha y hora actual -->
                            <h2 id="fechaHoraLabel"></h2>
                            <div class="form-group">
                                <button class="btn btn-success" id="btn">Fichar entrada</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>

<script>
    var latitude = 0
    var longitude = 0
    // Función para actualizar la fecha y hora actual en el label
    function actualizarFechaHora() {
        const fechaActual = new Date();
        const opciones = { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit' };
        const formatoDeseado = new Intl.DateTimeFormat('es-ES', opciones).format(fechaActual).replace(',', ' -');
        document.getElementById('fechaHoraLabel').textContent = formatoDeseado;
        let dataArray = formatoDeseado.split(' - ')
        $('#fecha').val(dataArray[0])
        let timeArray = dataArray[1].split(":")
        $('#horas').val(timeArray[0])
        $('#minutos').val(timeArray[1])
    }

    // Llamar a la función inicialmente y luego cada segundo para mantener la hora actualizada
    actualizarFechaHora();
    setInterval(actualizarFechaHora, 1000);

    $(document).ready(function() {
        //checkear si ya ha fichado
        var today = new Date();
        let todayEntrada = false
        let todaySalida = false
        today.setHours(0, 0, 0, 0);
        $('.imputaciones').each(function() {
            var createdAtDate = new Date($(this).data('fecha'));
            createdAtDate.setHours(0, 0, 0, 0);

            // Compare createdAtDate with today
            if (createdAtDate.getTime() === today.getTime()) {
                if($(this).data('tipo') == 0)
                    todaySalida = true
                else todayEntrada = true
            }
        });

        if(todayEntrada && !todaySalida){
            $("#isEntrada").val(false)
            $("#btn").html('Fichar salida');
        }

        // Check if geolocation is supported by the browser
        if ("geolocation" in navigator) {
            navigator.geolocation.getCurrentPosition(function(position) {
                latitude = position.coords.latitude;
                longitude = position.coords.longitude;

                console.log("Latitude: " + latitude + ", Longitude: " + longitude);
            }, function(error) {
                console.error("Error getting geolocation:", error);
            });
        } else {
            // Handle case where geolocation is not supported
            console.error("Geolocation is not supported by this browser.");
        }

        $('#add').submit(function(event) {
            event.preventDefault();
            
            var selectedOption = $('#selector option:selected');
            var selectedValue = selectedOption.val();
            var selectedCoords = selectedOption.data('coords');

            console.log("Selected Value:", selectedValue);
            console.log("Selected Coordinates:", selectedCoords);

            var coordsArray = selectedCoords.split(',')
            var comuniLat = parseFloat(coordsArray[0])
            var comuniLon = parseFloat(coordsArray[1])

            if(!insideComunidad(latitude, longitude, comuniLat, comuniLon, 1)){
                $('#alertLoc').show();
                return
            }                
            
            $(this)[0].submit();
        });
    });

    function calculateDistance(lat1, lon1, lat2, lon2) {
        // Convert latitude and longitude from degrees to radians
        var degToRad = function (degrees) {
            return degrees * (Math.PI / 180);
        };

        var R = 6371; // Radius of the Earth in kilometers
        var dLat = degToRad(lat2 - lat1);
        var dLon = degToRad(lon2 - lon1);

        var a =
            Math.sin(dLat / 2) * Math.sin(dLat / 2) +
            Math.cos(degToRad(lat1)) * Math.cos(degToRad(lat2)) *
            Math.sin(dLon / 2) * Math.sin(dLon / 2);
        var c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
        var distance = R * c; // Distance in kilometers

        return distance;
    }

    function insideComunidad(lat1, lon1, lat2, lon2, threshold) {
        var distance = calculateDistance(lat1, lon1, lat2, lon2);
        return distance <= threshold;
    }
</script>
<script>
    var initSelector = jQuery.noConflict();
    initSelector(document).ready(function () {
        if (initSelector("#selector").length > 0) {
            initSelector('#selector').select2({
                placeholder: 'Selecciona una comunidad',
                allowClear: true,
                language: {
                    noResults: function () {
                        return "No hay resultados";
                    },
                    searching: function () {
                        return "Buscando...";
                    }
                }
            });
        } else {
            console.log("No existe selector");
        }
    });
</script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.9/dist/sweetalert2.all.min.js"></script>

</html>