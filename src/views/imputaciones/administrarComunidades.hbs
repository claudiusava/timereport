<body>
  <div class="container p-4">
    <div class="row">
      <div class="col-md-4 mx-auto">
        <div class="card text-center">
          <div class="card-header">
            <strong>
              Añade una nueva comunidad.
            </strong>
          </div>
          <div class="card-body">
            <form id="guardarNuevaComunidadForm" action="/imputaciones/administrarComunidades" method="POST">
              <div class="form-group">
                <input type="text" name="nombre" placeholder="comunidad" class="form-control" autofocus required />
              </div>
              <div class="form-group">
                <input id="codigoInput" type="number" name="codigo" placeholder="código" class="form-control" min="0"
                  required />
                <span id="codigoError" style="color: red;"></span>
              </div>
              <div class="form-group">
                <input id="coordenadasInput" type="text" name="coordenadas" placeholder="coordenadas"
                  class="form-control" pattern="\d{1,2}\.\d+, -\d{1,3}\.\d+" required />
              </div>
              <div class="form-group">
                <button id="guardarNuevaComunidadButton" type="submit" class="btn btn-success">Guardar</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal para la edición -->
  <div class="modal fade" id="editarComunidadModal" tabindex="-1" role="dialog"
    aria-labelledby="editarComunidadModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="editarComunidadModalLabel">Editar Comunidad</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <!-- Formulario de edición -->
          <form id="editarComunidadForm" action="/imputaciones/administrarComunidades/editar" method="POST">
            <div class="form-group">
              <label for="nombreEdit">Nombre:</label>
              <input type="text" id="nombreEdit" name="nombre" class="form-control" required>
            </div>
            <div class="form-group">
              <label for="codigoEdit">Código:</label>
              <input type="number" id="codigoEdit" name="codigo" class="form-control" min="0" required>
            </div>
            <div class="form-group">
              <label for="coordenadasEdit">Coordenadas:</label>
              <input type="text" id="coordenadasEdit" name="coordenadas" class="form-control"
                pattern="\d{1,2}\.\d+, -\d{1,3}\.\d+" required>
            </div>
            <div class="form-group">
              <input type="hidden" id="idEdit" name="id">
              <button type="submit" class="btn btn-primary">Guardar Cambios</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>


  <div class="container p-4">
    <div class="row">
      <div class=" mx-auto">
        <div class="card text-center">
          <div class="card-header">
            <div class="card-body">
              <h1>Comunidades guardadas</h1>
              <div class="table-responsive">
                <table id="tablaComunidades" class="table table-bordered table-striped text-center mt-4">
                  <thead>
                    <tr class="text-white" style="background-color:#6200ee;">
                      <th scope="col">COMUNIDAD</th>
                      <th scope="col">CÓDIGO</th>
                      <th scope="col">COORDENADAS</th>
                      <th scope="col">ACCIONES</th>
                    </tr>
                  </thead>
                  <tbody>
                    {{#each comunidades}}
                    <tr data-codigo="{{codigo}}">
                      <td>
                        <p class="mb-1">{{nombre}}</p>
                      </td>
                      <td>
                        <p class="mb-1">{{codigo}}</p>
                      </td>
                      <td>
                        <p class="mb-1">{{coordenadas}}</p>
                      </td>
                      <td><a class="btn m-1 fa-solid fa-pen-to-square" style="font-size: large; color: blue;"
                          onclick="editar({{id}}, '{{nombre}}', {{codigo}}, '{{coordenadas}}')"></a>
                        <a class="btn m-1 fa-solid fa-trash-can" style="font-size: large; color: red;"
                          onclick="borrar({{id}})"></a>
                      </td>
                    </tr>
                    {{/each}}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script>
    function borrar(id) {
      Swal.fire({
        title: '¿Seguro que quieres eliminar esta comunidad?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Eliminar',
        confirmButtonColor: '#d63030',
        focusConfirm: 'true'
      }).then((result) => {
        if (result.isConfirmed) {
          window.location = '/imputaciones/administrarComunidades/delete/' + id;
        }
      })
    }

    function editar(id, nombre, codigo, coordenadas) {
      const formHTML = `<form id="editarComunidadForm">
    <div class="form-group">
      <label for="nombreEdit">Nombre:</label>
      <input type="text" id="nombreEdit" class="swal2-input" value="${nombre}" required>
    </div>
    <div class="form-group">
      <label for="codigoEdit">Código:</label>
      <input type="number" id="codigoEdit" class="swal2-input" value="${codigo}" min="0" required>
    </div>
    <div class="form-group">
      <label for="coordenadasEdit">Coordenadas:</label>
      <input type="text" id="coordenadasEdit" class="swal2-input" value="${coordenadas}" pattern="\d{1,2}\.\d+, -\d{1,3}\.\d+" required>
    </div>
  </form>`;

      const swalWithForm = Swal.fire({
        title: 'Editar Comunidad',
        html: formHTML,
        showCancelButton: true,
        confirmButtonText: 'Guardar Cambios',
        cancelButtonText: 'Cancelar',
        focusConfirm: false,
        showLoaderOnConfirm: true,
        preConfirm: () => {
          // La función preConfirm no se utilizará, ya que manejaremos el evento click del botón
        }
      });

      // Agregar un botón personalizado de "Guardar Cambios" al modal
      swalWithForm.then((result) => {
        if (result.isConfirmed) {
          Swal.fire({
            title: '¿Seguro que quieres guardar los cambios?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Sí',
            cancelButtonText: 'No'
          }).then((result) => {
            if (result.isConfirmed) {
              // Enviar el formulario al servidor
              const nombre = document.getElementById('nombreEdit').value;
              const codigo = document.getElementById('codigoEdit').value;
              const coordenadas = document.getElementById('coordenadasEdit').value;

              // Hacer una redirección a la ruta de actualización con los datos del formulario
              window.location = `/imputaciones/administrarComunidades/editar?id=${id}&nombre=${nombre}&codigo=${codigo}&coordenadas=${coordenadas}`;
            }
          });
        }
      });
    }



    document.getElementById('guardarNuevaComunidadForm').addEventListener('submit', async function (e) {
      e.preventDefault();

      var codigoInput = document.getElementById('codigoInput');
      var codigoComunidad = codigoInput.value.trim();
      var codigoError = document.getElementById('codigoError');

      // Obtener todas las filas de la tabla
      var filasTabla = document.querySelectorAll('#tablaComunidades tbody tr');

      var comunidadesBBDD = [];

      filasTabla.forEach(function (fila) {
        var codigo = fila.getAttribute('data-codigo');
        comunidadesBBDD.push(codigo);
      });

      codigoError.textContent = '';

      // Verificar si el código ya existe en el objeto 'comunidadesBBDD'
      var codigoExiste = comunidadesBBDD.some(function (codigo) {
        return codigo === codigoComunidad;
      });

      if (codigoExiste) {
        codigoError.textContent = 'Ya existe una comunidad con ese código.';
      } else {
        // Si pasa la validación, se enviará el formulario
        this.submit();
      }
    });
  </script>

