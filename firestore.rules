rules_version = '2';

// Modelo multi-empresa: todo cuelga de clientes/{clienteId}. Cada usuario
// lleva en su token los custom claims { clienteId, rol } que solo ponen las
// Cloud Functions. Para los permisos de administrador NO basta el token: se
// comprueba ademas el perfil en Firestore (rol y activo), asi un admin
// desactivado o degradado pierde el acceso al instante aunque su token siga
// vivo hasta 1 h.
//
// - Nadie lee ni escribe datos de otra empresa.
// - Trabajadores: solo sus propios registros y las comunidades asignadas.
// - Admin: todo lo de su empresa.
// - Registro de jornada (RD-ley 8/2019): los fichajes solo los crean las
//   Cloud Functions y nadie los modifica ni borra; se anulan con motivo y
//   queda en la auditoria. Lo mismo con los controles de agua.

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function delCliente(c) {
      return autenticado() && request.auth.token.clienteId == c;
    }

    function perfil(c) {
      return get(/databases/$(database)/documents/clientes/$(c)/usuarios/$(request.auth.uid)).data;
    }

    function clienteActivo(c) {
      return get(/databases/$(database)/documents/clientes/$(c)).data.activo == true;
    }

    function esAdmin(c) {
      return delCliente(c)
        && request.auth.token.rol == 'admin'
        && perfil(c).rol == 'admin'
        && perfil(c).activo == true;
    }

    function textoValido(valor, min, max) {
      return valor is string && valor.size() >= min && valor.size() <= max;
    }

    function numeroEntre(valor, min, max) {
      return valor is number && valor >= min && valor <= max;
    }

    function enteroEntre(valor, min, max) {
      return valor is int && valor >= min && valor <= max;
    }

    function comunidadBienFormada(data) {
      return textoValido(data.nombre, 1, 200)
        && textoValido(data.codigo, 1, 45)
        && data.ubicacion is latlng
        && data.asignados is list
        && data.activa is bool;
    }

    match /clientes/{c} {
      // Marca y configuracion: se leen ANTES del login para pintar el logo y
      // los colores. No contiene nada sensible. No se permite listar.
      // Solo se modifica con la Cloud Function actualizarEmpresa.
      allow get: if true;
      allow list: if false;
      allow write: if false;

      match /usuarios/{uid} {
        allow get: if esAdmin(c) || (delCliente(c) && request.auth.uid == uid);
        allow list: if esAdmin(c);
        // Solo Cloud Functions (sincronizan Auth, claims y este documento).
        allow write: if false;
      }

      match /comunidades/{comunidadId} {
        // La consulta del trabajador debe filtrar por
        // where('asignados', 'array-contains', uid) para que la regla se cumpla.
        allow read: if esAdmin(c)
          || (delCliente(c) && request.auth.uid in resource.data.asignados);

        // Las asignaciones (asignados) las gestionan las Cloud Functions al
        // editar usuarios: aqui se crea vacia y no se toca.
        allow create: if esAdmin(c)
          && clienteActivo(c)
          && request.resource.data.keys().hasOnly(
            ['nombre', 'codigo', 'ubicacion', 'asignados', 'activa', 'createdAt'])
          && request.resource.data.keys().hasAll(
            ['nombre', 'codigo', 'ubicacion', 'asignados', 'activa', 'createdAt'])
          && comunidadBienFormada(request.resource.data)
          && request.resource.data.asignados.size() == 0
          && request.resource.data.createdAt == request.time;

        allow update: if esAdmin(c)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['nombre', 'codigo', 'ubicacion', 'activa'])
          && comunidadBienFormada(request.resource.data);

        // Los fichajes y controles guardan el nombre de la comunidad, asi que
        // borrarla no pierde informacion.
        allow delete: if esAdmin(c);
      }

      match /imputaciones/{id} {
        // Las consultas del trabajador deben filtrar por where('uid', '==', uid).
        allow read: if esAdmin(c)
          || (delCliente(c) && resource.data.uid == request.auth.uid);
        // Solo Cloud Functions: fichar, registrarFichajeManual, anularRegistro.
        allow write: if false;
      }

      match /controlesAgua/{id} {
        allow read: if esAdmin(c)
          || (delCliente(c) && resource.data.uid == request.auth.uid);

        // El socorrista crea el control (con la hora del servidor) y despues
        // sube la foto a la ruta que indica fotoPath (ver storage.rules).
        allow create: if delCliente(c)
          && clienteActivo(c)
          && perfil(c).activo == true
          && perfil(c).rol in ['admin', 'socorrista']
          && request.resource.data.keys().hasOnly(
            ['uid', 'usuarioNombre', 'comunidadId', 'comunidadNombre', 'cloro', 'ph',
             'banistas', 'rebosadero', 'aguaDepurada', 'fotoPath', 'fecha', 'anulado'])
          && request.resource.data.keys().hasAll(
            ['uid', 'usuarioNombre', 'comunidadId', 'comunidadNombre', 'cloro', 'ph',
             'banistas', 'rebosadero', 'aguaDepurada', 'fotoPath', 'fecha', 'anulado'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.usuarioNombre == perfil(c).nombre
          && request.resource.data.fecha == request.time
          && request.resource.data.anulado == null
          && numeroEntre(request.resource.data.cloro, 0, 20)
          && numeroEntre(request.resource.data.ph, 0, 14)
          && enteroEntre(request.resource.data.banistas, 0, 10000)
          && enteroEntre(request.resource.data.rebosadero, 0, 100000)
          && numeroEntre(request.resource.data.aguaDepurada, 0, 1000000)
          && request.resource.data.fotoPath ==
            'clientes/' + c + '/controlesAgua/' + request.auth.uid + '/' + id + '.jpg'
          && comunidadValida(c, request.resource.data);

        // Solo Cloud Functions (anularRegistro).
        allow update, delete: if false;
      }

      // Registro de auditoria: solo lo escriben las Cloud Functions.
      match /auditoria/{id} {
        allow read: if esAdmin(c);
        allow write: if false;
      }
    }

    // La comunidad existe, esta activa, el nombre guardado coincide y el
    // trabajador la tiene asignada (el admin puede usar cualquiera).
    function comunidadValida(c, data) {
      let ruta = /databases/$(database)/documents/clientes/$(c)/comunidades/$(data.comunidadId);
      return data.comunidadId is string
        && exists(ruta)
        && get(ruta).data.activa == true
        && get(ruta).data.nombre == data.comunidadNombre
        && (perfil(c).rol == 'admin' || request.auth.uid in get(ruta).data.asignados);
    }

    // Cualquier otra ruta: denegada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
